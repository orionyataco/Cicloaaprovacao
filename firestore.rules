rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 1. Coleção de Notificações (Real-time)
    match /notifications/{notificationId} {
      allow read, delete: if request.auth != null && request.auth.uid == resource.data.toUid;
      allow create: if request.auth != null;
      allow update: if request.auth != null && request.auth.uid == resource.data.toUid;
    }
    
    // 2. Questões Compartilhadas (Real-time)
    match /shared_questions/{questionId} {
      allow read, delete: if request.auth != null && request.auth.uid == resource.data.toUid;
      allow create: if request.auth != null;
    }

    // 3. Perfis Públicos (Rankings e Busca)
    match /profiles/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // 4. Documento Base do Usuário (Sync de Estado)
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // 5. Questões públicas compartilhadas
    match /public_questions/{questionId} {
      // Qualquer pessoa pode ler (visitantes sem conta)
      allow read: if true;
      // Apenas usuários autenticados podem criar
      allow create: if request.auth != null;
      // Apenas o criador pode deletar
      allow delete: if request.auth != null && resource.data.fromUid == request.auth.uid;
      // Permitir update de views/solves por qualquer um
      allow update: if request.resource.data.diff(resource.data).affectedKeys()
                      .hasOnly(['views', 'solves']);
    }

    // 6. Feed da Comunidade (posts, questões com gabarito, dicas, links, comentários e curtidas)
    match /feed_posts/{postId} {
      // Qualquer visitante ou aluno pode ler os posts do feed
      allow read: if true;
      // Usuários autenticados podem publicar novos posts
      allow create: if request.auth != null;
      // Usuários autenticados podem interagir (curtir, responder enquetes/questões e comentar)
      allow update: if request.auth != null;
      // Apenas o próprio autor do post pode excluí-lo
      allow delete: if request.auth != null && resource.data.authorId == request.auth.uid;
    }

    // Regra padrão de segurança: Bloqueia qualquer outro acesso não explicitado acima
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
